# Copy to .env for local overrides. Keep real credentials out of Git.
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Docker Compose PostgreSQL credentials. Replace these placeholders locally.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=weekly_feedback
DB_USER=weekly_feedback
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=localhost
DB_PORT=5433
